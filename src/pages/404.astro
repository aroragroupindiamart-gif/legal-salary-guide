---
import Layout from '../layouts/Layout.astro';
---

<Layout title="404 Page Not Found | Legal Salary Guide" description="The page you are looking for does not exist on Legal Salary Guide. Search salaries, rent, and cost of living metrics across the US.">
  <div class="max-w-xl mx-auto px-4 py-24 sm:py-32 text-center space-y-8 relative z-10">
    <!-- Icon or graphical illustration -->
    <div class="inline-flex items-center justify-center w-24 h-24 rounded-full bg-indigo-500/10 border border-indigo-500/20 text-indigo-400 text-5xl animate-bounce">
      <i class="fa-solid fa-triangle-exclamation"></i>
    </div>
    
    <div class="space-y-4">
      <h1 class="text-7xl sm:text-8xl font-black tracking-tight text-transparent bg-clip-text bg-gradient-to-r from-indigo-400 via-violet-400 to-fuchsia-400">
        404
      </h1>
      <h2 class="text-2xl sm:text-3xl font-extrabold text-white">
        Page Not Found
      </h2>
      <p class="text-slate-400 text-sm sm:text-base leading-relaxed max-w-md mx-auto">
        Oops! We couldn't find the page you are looking for. It may have been moved, deleted, or never existed in the first place.
      </p>
    </div>

    <!-- Navigation actions -->
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4 pt-4">
      <a href="/" class="w-full sm:w-auto px-6 py-3 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white font-semibold shadow-lg shadow-indigo-600/20 hover:scale-[1.02] transition-all duration-200">
        <i class="fa-solid fa-house mr-2"></i>Back to Home
      </a>
      <a href="/directory" class="w-full sm:w-auto px-6 py-3 rounded-xl bg-slate-900 border border-slate-800 hover:border-slate-700 text-slate-300 hover:text-white font-semibold hover:scale-[1.02] transition-all duration-200">
        <i class="fa-solid fa-folder-open mr-2"></i>Browse Directory
      </a>
    </div>
  </div>
</Layout>
