---
import Layout from '../../../layouts/Layout.astro';
import getDb from '../../../data/db.js';

const { state, city } = Astro.params;
const cleanState = (state || '').toLowerCase().trim();
const cleanCity = (city || '').toLowerCase().trim();

let recordList = [];
const db = getDb(Astro.locals.runtime);

try {
  const res = await db.prepare(`
    SELECT job_title, median_salary, disposable_income 
    FROM permutations 
    WHERE state = ? AND city = ? 
    ORDER BY median_salary DESC
  `).bind(cleanState, cleanCity).all();
  recordList = res.results || [];
} catch (e) {
  console.error("Directory jobs query error:", e);
}

// Format name helper
const formatName = (str: string) => {
  if (!str) return '';
  return str
    .split('-')
    .map(word => word.charAt(0).toUpperCase() + word.slice(1))
    .join(' ');
};

const formatCurrency = (val: number) => {
  return new Intl.NumberFormat('en-US', {
    style: 'currency',
    currency: 'USD',
    maximumFractionDigits: 0
  }).format(val);
};

const displayCity = formatName(cleanCity);
const displayState = cleanState.toUpperCase();

const hasRecords = recordList.length > 0;
if (!hasRecords) {
  Astro.response.status = 404;
}
---

<Layout title={hasRecords ? `Living Wages in ${displayCity}, ${displayState} | Legal Salary Guide Directory` : "City Not Found | Legal Salary Guide"}>
  <div class="max-w-4xl mx-auto px-4 py-12 sm:px-6 lg:px-8">
    <nav class="flex text-sm text-slate-400 mb-6">
      <a href="/" class="hover:text-white transition-colors">Home</a>
      <span class="mx-2">/</span>
      <a href="/directory" class="hover:text-white transition-colors">Directory</a>
      <span class="mx-2">/</span>
      <a href={`/directory/${cleanState}`} class="hover:text-white transition-colors">{displayState}</a>
      <span class="mx-2">/</span>
      <span class="text-indigo-400 font-medium">{displayCity}</span>
    </nav>

    {hasRecords ? (
      <>
        <h1 class="text-3xl font-extrabold text-white mb-2">Living Wages in {displayCity}, {displayState}</h1>
        <p class="text-slate-400 text-sm mb-8">Compare average salaries and disposable incomes for all occupations in {displayCity}.</p>
        
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          {recordList.map(item => (
            <a 
              href={`/${cleanState}/${cleanCity}/${item.job_title}`}
              class="bg-slate-900/60 hover:bg-slate-900 border border-slate-850 hover:border-indigo-500/50 p-4 rounded-xl text-white transition-all shadow-md flex justify-between items-center group"
            >
              <div>
                <span class="font-bold group-hover:text-indigo-300 transition-colors block">{formatName(item.job_title)}</span>
                <span class="text-xs text-slate-400">Salary: {formatCurrency(item.median_salary)}</span>
              </div>
              <div class="text-right">
                <span class="text-xs text-slate-500 block">Disposable</span>
                <span class={`font-extrabold text-sm ${item.disposable_income < 0 ? 'text-rose-500' : 'text-emerald-400'}`}>
                  {formatCurrency(item.disposable_income)}
                </span>
              </div>
            </a>
          ))}
        </div>
      </>
    ) : (
      <div class="bg-slate-900/60 backdrop-blur-md rounded-2xl p-8 border border-slate-800 text-center shadow-xl space-y-6 max-w-2xl mx-auto my-12">
        <div class="w-16 h-16 rounded-full bg-rose-500/10 text-rose-500 flex items-center justify-center mx-auto">
          <i class="fa-solid fa-face-frown text-2xl"></i>
        </div>
        <div>
          <h2 class="text-xl font-bold text-white">City Not Found</h2>
          <p class="text-slate-400 text-sm mt-2 leading-relaxed">
            We currently don't have calculation records indexed for the city <strong class="text-white font-medium">{displayCity}</strong> in <strong class="text-white font-medium">{displayState}</strong>.
          </p>
        </div>
        <div class="pt-4">
          <a href={`/directory/${cleanState}`} class="inline-flex items-center space-x-2 px-5 py-2.5 bg-indigo-600 hover:bg-indigo-500 active:bg-indigo-700 text-white text-sm font-semibold rounded-xl transition-all shadow-lg shadow-indigo-600/20 hover:shadow-indigo-600/30">
            <i class="fa-solid fa-arrow-left"></i>
            <span>Return to {displayState} Cities</span>
          </a>
        </div>
      </div>
    )}
  </div>
</Layout>
