---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Legal Salary & Cost of Living Guide - Compare wages, housing costs, taxes, and disposable income across the US." } = Astro.props;
const cleanState = (Astro.params.state || '').toLowerCase().trim();
const cleanCity = (Astro.params.city || '').toLowerCase().trim();
const cleanJob = (Astro.params.jobTitle || '').toLowerCase().trim();

// Construct canonical URL (canonical domain)
const canonicalURL = new URL(Astro.url.pathname, 'https://legalsalaryguide.com');
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- Robots meta tag for indexing -->
    <meta name="robots" content="index, follow" />

    <!-- Canonical Link -->
    <link rel="canonical" href={canonicalURL} />
    
    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="Legal Salary Guide" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />

    <!-- Google Fonts: Outfit (headings) & Inter (body) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Outfit:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

    <!-- CDN for FontAwesome icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
  </head>
  <body class="bg-slate-950 text-slate-100 font-sans min-h-screen flex flex-col antialiased selection:bg-indigo-500 selection:text-white">
    <!-- Background glow elements -->
    <div class="fixed inset-0 overflow-hidden pointer-events-none z-0">
      <div class="absolute -top-[40%] -left-[20%] w-[80%] h-[80%] rounded-full bg-indigo-900/10 blur-[150px]"></div>
      <div class="absolute -bottom-[40%] -right-[20%] w-[80%] h-[80%] rounded-full bg-violet-900/10 blur-[150px]"></div>
    </div>

    <!-- Navigation Header -->
    <header class="sticky top-0 z-50 backdrop-blur-md bg-slate-950/75 border-b border-slate-900">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
        <a href="/" class="flex items-center space-x-3 group">
          <div class="w-9 h-9 rounded-lg bg-gradient-to-tr from-indigo-500 to-violet-600 flex items-center justify-center shadow-lg shadow-indigo-500/20 group-hover:scale-105 transition-transform">
            <i class="fa-solid fa-chart-pie text-white text-sm"></i>
          </div>
          <span class="font-heading font-bold text-lg tracking-tight bg-gradient-to-r from-white via-slate-100 to-slate-400 bg-clip-text text-transparent">
            LegalSalary<span class="text-indigo-400">Guide</span>
          </span>
        </a>
        <nav class="hidden md:flex items-center space-x-6 text-sm font-medium text-slate-300">
          <a href="/" class="hover:text-indigo-400 transition-colors">Home</a>
          <a href="/about" class="hover:text-indigo-400 transition-colors">About Legal Salary Guide</a>
        </nav>
      </div>
    </header>

    <!-- Main Content Area -->
    <main class="flex-grow relative z-10">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="bg-slate-950 border-t border-slate-900 py-8 relative z-10">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col md:flex-row items-center justify-between text-slate-400 text-sm">
        <div class="flex items-center space-x-2 mb-4 md:mb-0">
          <span>&copy; {new Date().getFullYear()} LegalSalaryGuide.</span>
          <span class="text-slate-600">|</span>
          <span class="text-slate-500">Salary & Cost of Living Index</span>
        </div>
        <div class="flex space-x-6 text-slate-500">
          <a href="https://simplemaps.com/data/us-cities" class="hover:text-slate-300 transition-colors text-xs" target="_blank" rel="noopener">US Cities database by Simplemaps</a>
          <a href="https://www.bls.gov" class="hover:text-slate-300 transition-colors text-xs" target="_blank" rel="noopener">Salaries data by BLS</a>
        </div>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --font-sans: 'Inter', sans-serif;
    --font-heading: 'Outfit', sans-serif;
  }
  
  h1, h2, h3, h4, h5, h6 {
    font-family: var(--font-heading);
  }
</style>
